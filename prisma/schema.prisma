// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String    @unique
  name          String?
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  addresses     Address[]
  orders        Order[]
  cart          Cart?
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   // "Home", "Office"
  recipientName String
  phone         String
  addressLine1  String
  addressLine2  String?
  city          String
  province      String
  postalCode    String
  country       String   @default("Indonesia")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
}

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  description      String
  shortDescription String?
  price            BigInt        // IDR in minor units (sen) - but we'll store as rupiah integer
  compareAtPrice   BigInt?
  salePrice        BigInt?
  sku              String?       @unique
  stock            Int           @default(0)
  status           ProductStatus @default(published)
  image            String
  images           Json          // additional images
  tags             Json?
  relatedProductIds Json?
  seoTitle         String?
  seoDescription   String?
  seoCanonical     String?
  seoIndexable     Boolean       @default(true)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  cartItems        CartItem[]
  orderItems       OrderItem[]
}

enum ProductStatus {
  published
  draft
  archived
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique // e.g., PA-20260816-0001
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  status          OrderStatus  @default(PENDING_PAYMENT)
  subtotal        BigInt       // sum of line items
  shippingCost    BigInt       @default(0)
  total           BigInt       // subtotal + shipping
  currency        String       @default("IDR")
  shippingAddress Json         // snapshot of address at order time
  shippingMethod  String?      // courier + service (e.g., "JNE REG")
  shippingRate    Json?        // full rate quote snapshot
  midtransOrderId String?      @unique
  midtransToken   String?      // Snap token
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     BigInt   // price at time of order
  subtotal  BigInt   // price * quantity
  createdAt DateTime @default(now())
}

model OrderStatusHistory {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime     @default(now())
}

model AuditLog {
  id            String    @id @default(cuid())
  actorKind     String // system | customer | staff
  actorId       String?
  actorEmail    String?
  actorRole     String?
  action        String
  targetType    String
  targetId      String
  outcome       String // succeeded | denied | failed | pending
  correlationId String?
  before        Json?
  after         Json?
  reason        String?
  ipAddress     String?
  occurredAt    DateTime  @default(now())

  @@index([occurredAt])
  @@index([targetType, targetId])
  @@index([actorId])
}

model Notification {
  id         String    @id @default(cuid())
  type       String // order_paid | payment_webhook_failed | low_stock | ...
  severity   String    @default("info") // info | warning | critical
  title      String
  message    String?
  targetType String?
  targetId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([readAt])
  @@index([createdAt])
}

model SystemControl {
  key         String    @id
  value       Boolean   @default(false)
  label       String
  updatedById String?
  updatedAt   DateTime  @updatedAt
}