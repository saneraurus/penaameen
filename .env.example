# Environment variables for the PENA AMEEN Digital Commerce Platform.
# Copy to .env.local for local development, or to .env for production.
# Do NOT commit real production credentials to this file.

# === Application ===
APP_ENV=development
APP_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL is the browser-facing origin; APP_BASE_URL is server-facing.
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1

# Comma-separated browser origins allowed to submit cookie-authenticated
# mutations. Keep empty locally when APP_BASE_URL is the only origin.
TRUSTED_ORIGINS=

# === Database ===
# enabling FORCE ROW LEVEL SECURITY on customer-owned tables.
# ownership for audited staff operations.
# === Database (Supabase Postgres — single source of truth) ===
# CLI only (prisma migrate deploy/status). Session-mode pooler, owns DDL (postgres role).
# === Database (Supabase Postgres — single source of truth) ===
SUPABASE_DB_URL=postgresql://penaameen_app.<project-ref>:<APP_PASSWORD>@<pooler-host>:6543/postgres?pgbouncer=true&uselibpqcompat=true&sslmode=require
SUPABASE_DB_STAFF_URL=postgresql://penaameen_staff.<project-ref>:<STAFF_PASSWORD>@<pooler-host>:5432/postgres?uselibpqcompat=true&sslmode=require
# CLI only (prisma migrate deploy/status): session pooler, DDL owner (postgres role).
SUPABASE_DB_MIGRATE_URL=postgresql://postgres.<project-ref>:<POSTGRES_PASSWORD>@<pooler-host>:5432/postgres?uselibpqcompat=true&sslmode=require
RLS_ENABLED=true

# === Clerk Authentication ===
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
CLERK_ORG_ID=org_your_organization_id
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# Staff / Admin Email Allowlist (comma-separated)
ADMIN_EMAILS=owner@penaameen.com,admin@penaameen.com

# === BuatQRIS (primary payment provider — dynamic QRIS) ===
# Docs: https://buatqris.site | API base: https://api.buatqris.site
BUATQRIS_ACCOUNT_ID=user_your_account_id
BUATQRIS_SECRET_TOKEN=sk_live_your_secret_token
BUATQRIS_API_BASE_URL=https://api.buatqris.site
BUATQRIS_EXPIRY_MINUTES=15

# === Casaku QRIS (legacy payment provider) ===
# Docs: https://casaku.id/docs | API base: https://api.casaku.id
CASAKU_LICENSE_KEY=cashify_your_license_key
CASAKU_WEBHOOK_SECRET=cashify_your_webhook_secret
CASAKU_QR_ID=00000000-0000-0000-0000-000000000000
CASAKU_API_BASE_URL=https://api.casaku.id
CASAKU_EXPIRY_MINUTES=15
CASAKU_PACKAGE_IDS=id.dana,com.gojek.gopaymerchant,com.shopee.id,com.bca.msb,id.bmri.livinmerchant,id.co.bri.merchant,id.co.bni.merchant,com.cimbedc,id.co.bankbsi.byond

# === Midtrans (backup payment provider) ===
MIDTRANS_SERVER_KEY=SB-Mid-server-your_key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-your_key
MIDTRANS_IS_PRODUCTION=false

# === RajaOngkir (shipping provider) ===
RAJAONGKIR_API_KEY=your_rajaongkir_api_key

# === Resend (email provider) ===
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Pena Ameen <no-reply@penaameen.com>"

# === AI Customer Service (TANYA AMEEN) ===
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_API_KEY=nvapi_your_nvidia_api_key
NVIDIA_API_KEY_FALLBACK=nvapi_your_nvidia_api_key_fallback
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# === Google Sheets (product master data + stock) ===
# Auth via a Google Cloud Service Account JSON (full JSON content, single line).
# Share the spreadsheet with the service account client_email (Editor role).
GOOGLE_SHEETS_SPREADSHEET_ID=1OlK9J1kw9U4Br9OCdzVsBw5aabVQ24jwWRNCFFtHETc
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEETS_SHEET_NAME=Sheet1
GOOGLE_SHEETS_MOVEMENT_SHEET_NAME=MUTASI STOCK

# === Encryption (for api_settings.json at-rest secrets) ===
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SETTINGS_ENCRYPTION_KEY=
