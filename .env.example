# Local development only. Do not add real credentials or production values.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1

# Database (PostgreSQL). For local dev, run `npm run db:start` (embedded Postgres).
DATABASE_URL=postgresql://postgres:password@localhost:5432/penaameen
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_tes-[REDACTED]
CLERK_ORG_ID=org_your_organization_id

# Clerk Webhook Secret (for syncing org membership)
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# AI Customer Service (TANYA AMEEN) - GROQ
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Public admin WhatsApp number used for checkout/manual-payment confirmation
# and order support links (international format, e.g. 6281234567890). Leave
# empty to hide WhatsApp actions until a real number is configured.
NEXT_PUBLIC_ADMIN_WHATSAPP=

# Casaku QRIS (primary payment provider — dynamic QRIS).
# Docs: https://casaku.id/docs | API base: https://api.casaku.id
# License key + webhook secret from Casaku dashboard (API Keys).
CASAKU_LICENSE_KEY=cashify_[REDACTED]
CASAKU_WEBHOOK_SECRET=cashify_[REDACTED]
# QRIS Merchant ID (UUID) from Casaku dashboard.
CASAKU_QR_ID=00000000-0000-0000-0000-000000000000
CASAKU_API_BASE_URL=https://api.casaku.id
# QR expiry in minutes (default 15).
CASAKU_EXPIRY_MINUTES=15
# Wallet apps monitored by Casaku (comma-separated package IDs).
CASAKU_PACKAGE_IDS=id.dana,com.gojek.gopaymerchant,com.shopee.id,com.bca.msb,id.bmri.livinmerchant,id.co.bri.merchant,id.co.bni.merchant,com.cimbedc,id.co.bankbsi.byond
NVIDIA_API_KEY=nvapi_your_nvidia_api_key
NVIDIA_API_KEY_FALLBACK=nvapi_your_nvidia_api_key
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Google Sheets (STOCK PENAAMEEN) - product master data + stock.
# Auth via a Google Cloud Service Account JSON (full JSON content, single line).
# Share the spreadsheet with the service account client_email (Editor role).
# Leave empty to disable the feature (admin mutations fail closed with 503).
GOOGLE_SHEETS_SPREADSHEET_ID=1OlK9J1kw9U4Br9OCdzVsBw5aabVQ24jwWRNCFFtHETc
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
# Alternatif yang lebih aman untuk development lokal: path ke file JSON key.
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=
# Tab names (auto-created if missing).
GOOGLE_SHEETS_SHEET_NAME=Sheet1
GOOGLE_SHEETS_MOVEMENT_SHEET_NAME=MUTASI STOCK
