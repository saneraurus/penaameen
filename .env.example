# Local development only. Do not add real credentials or production values.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1

# Database (PostgreSQL). For local dev, run `npm run db:start` (embedded Postgres).
DATABASE_URL=postgresql://postgres:password@localhost:5432/penaameen
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_tes-[REDACTED]
CLERK_ORG_ID=org_your_organization_id

# Clerk Webhook Secret (for syncing org membership)
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# AI Customer Service (TANYA AMEEN) - GROQ
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Public admin WhatsApp number used for checkout/manual-payment confirmation
# and order support links (international format, e.g. 6281234567890). Leave
# empty to hide WhatsApp actions until a real number is configured.
NEXT_PUBLIC_ADMIN_WHATSAPP=
